PORT=5000
NODE_ENV=development

# Database (SQLite for local development)
# To switch to PostgreSQL, change the provider in prisma/schema.prisma
# and set DATABASE_URL="postgresql://user:password@localhost:5432/saifi_brands?schema=public"
DATABASE_URL="file:./saifi.db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal
PAYPAL_CLIENT_ID="your-client-id"
PAYPAL_CLIENT_SECRET="your-client-secret"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@saifibrands.com"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
